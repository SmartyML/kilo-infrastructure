{
  "$schema": "https://app.kilo.ai/config.json",
  "instructions": [
    "/root/admin/AGENTS.md"
  ],
  "model": "deepseek/deepseek-flash",
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "Authorization": "ctx7sk-67dd4f68-4017-4133-8d23-16d379aaab97"
      },
      "enabled": true
    }
  },
  "permission": {
    "*": "allow",

    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "task": "allow",
    "skill": "allow",
    "lsp": "allow",
    "todoread": "allow",
    "todowrite": "allow",

    "context7_*": "ask",
    "context7_resolve-library-id": "allow",
    "context7_query-docs": "allow",

    "edit": "allow",
    "write": "allow",

    "external_directory": {
      "*": "allow"
    },

    "bash": {
      "*": "allow",

      "rm *": "allow",
      "rm -r *": "ask",
      "rm -R *": "ask",
      "rm -rf *": "ask",
      "rm -fr *": "ask",
      "rmdir *": "allow",

      "mv *": "allow",
      "cp *": "allow",
      "mkdir *": "allow",
      "touch *": "allow",
      "chmod *": "allow",
      "chown *": "allow",

      "systemctl *": "allow",
      "journalctl *": "allow",

      "apt *": "allow",
      "apt-get *": "allow",
      "apt remove *": "ask",
      "apt purge *": "ask",
      "apt autoremove *": "ask",
      "apt-get remove *": "ask",
      "apt-get purge *": "ask",
      "apt-get autoremove *": "ask",

      "dpkg *": "allow",

      "git *": "allow",
      "git reset --hard *": "ask",
      "git clean -f *": "ask",
      "git clean -fd *": "ask",
      "git clean -fdx *": "ask",

      "node *": "allow",
      "npm *": "allow",
      "npx *": "allow",
      "pnpm *": "allow",
      "corepack *": "allow",

      "curl *": "allow",
      "wget *": "allow",

      "echo *": "allow",
      "cat *": "allow",
      "ls *": "allow",
      "grep *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "awk *": "allow",
      "sed *": "allow",
      "printf *": "allow",
      "find *": "allow",
      "stat *": "allow",
      "readlink *": "allow",
      "realpath *": "allow",
      "tar *": "allow",

      "ip addr show *": "allow",
      "ip route show *": "allow",
      "ip route get *": "allow",
      "ip link show *": "allow",
      "ip neigh *": "allow",
      "ss *": "allow",
      "dig *": "allow",
      "getent *": "allow",
      "ping *": "allow",

      "ip addr add *": "ask",
      "ip addr del *": "ask",
      "ip route add *": "ask",
      "ip route del *": "ask",
      "ip link set *": "ask",

      "iptables *": "ask",
      "ip6tables *": "ask",
      "nft *": "ask",

      "reboot *": "ask",
      "shutdown *": "ask",
      "poweroff *": "ask",
      "halt *": "ask",

      "passwd *": "ask",
      "userdel *": "ask",
      "groupdel *": "ask",
      "usermod *": "ask",

      "kill *": "ask",
      "killall *": "ask",
      "pkill *": "ask",

      "mount *": "ask",
      "umount *": "ask",

      "mkfs *": "deny",
      "mkfs.*": "deny",
      "fdisk *": "deny",
      "cfdisk *": "deny",
      "sfdisk *": "deny",
      "parted *": "deny",
      "wipefs *": "deny",
      "dd *": "deny"
    }
  }
}
